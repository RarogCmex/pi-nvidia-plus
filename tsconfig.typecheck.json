{
  // Тайпчек спайка против типов пи:
  //   tsc -p tsconfig.typecheck.json
  // Требует симлинк (вне гита):
  //   mkdir -p node_modules/@earendil-works
  //   ln -sfn ~/.local/lib/node_modules/@earendil-works/pi-coding-agent node_modules/@earendil-works/pi-coding-agent
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["extensions/*.ts", "test/*.ts"]
}
