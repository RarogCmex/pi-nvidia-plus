{
  // Тайпчек против типов pi:
  //   npm run typecheck        (tsc -p tsconfig.typecheck.json)
  // Требует один раз слинковать типы pi из глобальной установки (вне гита):
  //   node scripts/link-pi.mjs
  // Скрипт сам находит pi (npm -g, nvm, pnpm, ~/.local); для конкретного пути:
  //   PI_ROOT=/path/to/node_modules node scripts/link-pi.mjs
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["extensions/*.ts", "test/*.ts"]
}
