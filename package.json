{
  "name": "@rarogcmex/pi-nvidia-plus",
  "version": "0.2.2",
  "description": "Pi extension that improves the built-in nvidia provider in place: thinking-level control, up-to-date model catalog, request normalization, per-provider proxy, key rotation and 429/5xx diagnostics",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RarogCmex/pi-nvidia-plus.git"
  },
  "bugs": {
    "url": "https://github.com/RarogCmex/pi-nvidia-plus/issues"
  },
  "homepage": "https://github.com/RarogCmex/pi-nvidia-plus#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "nvidia",
    "nim",
    "thinking-control",
    "proxy-pool"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "extensions/",
    "overrides/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "npm run typecheck && npm test",
    "acceptance:proxy-pool": "node scripts/proxy-pool-acceptance.mjs",
    "acceptance:agent-dir": "node scripts/agent-dir-acceptance.mjs",
    "discover": "node scripts/discover-models.mjs",
    "bench:proxies": "node scripts/test-proxies.mjs"
  },
  "pi": {
    "extensions": [
      "extensions/pi-nvidia-plus.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "undici": "^8.10.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
