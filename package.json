{
  "name": "pi-nvidia-plus",
  "version": "0.1.0",
  "description": "Pi extension that improves the built-in nvidia provider in place: thinking-level control, up-to-date model catalog, request normalization, per-provider proxy, key rotation and 429/5xx diagnostics",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "nvidia",
    "nim",
    "llm-provider"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "extensions/",
    "overrides/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "extensions/pi-nvidia-plus.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "acceptance:proxy-pool": "node scripts/proxy-pool-acceptance.mjs"
  },
  "devDependencies": {
    "undici": "^8.10.2"
  }
}
